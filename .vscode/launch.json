{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Root Context)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: FastAPI (Uvicorn Reload)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "my_web_app.app:app",
                "--reload"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}